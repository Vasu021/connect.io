{
  "name": "connect-io",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "test": "npm run test --workspace server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "npm run prisma:push --workspace server",
    "db:studio": "npm run prisma:studio --workspace server",
    "setup": "npm install && npm run db:up && npm run db:push"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true
  },
  "overrides": {
    "ws": "^8.22.0",
    "engine.io": "^6.6.11",
    "engine.io-client": "^6.6.7",
    "socket.io-parser": "^4.2.7",
    "socket.io-adapter": "^2.5.8",
    "deepmerge-ts": "^8.0.2"
  }
}

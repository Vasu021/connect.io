// connect.io — data model
//
// A game is scored on the PAIR, not the player: `finalScore` is the round
// number on which both players submitted the same word. Lower is better.
// Only games with outcome MATCHED carry a score and reach the leaderboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum GameOutcome {
  /// Both players submitted the same word — the only outcome that scores.
  MATCHED
  /// Round cap reached without a match.
  UNMATCHED
  /// A player dropped and did not return within the grace period.
  ABANDONED
  /// A player deliberately ended the game.
  FORFEITED
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  /// Lowercased mirror of `username`, so lookups and uniqueness are
  /// case-insensitive without relying on a Postgres-specific citext type.
  usernameLower String   @unique
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())

  sentRequests     FriendRequest[] @relation("RequestFrom")
  receivedRequests FriendRequest[] @relation("RequestTo")
  friendshipsA     Friendship[]    @relation("FriendA")
  friendshipsB     Friendship[]    @relation("FriendB")
  gamesAsPlayer1   Game[]          @relation("Player1")
  gamesAsPlayer2   Game[]          @relation("Player2")

  @@index([usernameLower])
}

model FriendRequest {
  id          String              @id @default(uuid())
  fromUserId  String
  toUserId    String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  fromUser User @relation("RequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("RequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  /// Pairs are stored with user1Id < user2Id (lexicographic) so the unique
  /// constraint catches duplicates regardless of who sent the request.
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("FriendA", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendB", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Game {
  id        String      @id @default(uuid())
  roomCode  String      @unique
  player1Id String
  player2Id String
  status    GameStatus  @default(WAITING)
  outcome   GameOutcome?
  /// Round number the pair matched on. Null unless outcome is MATCHED.
  finalScore Int?

  /// Live round state, persisted so an in-progress game survives a restart.
  currentRound  Int      @default(0)
  roundDeadline DateTime?
  /// Map of userId -> submitted word for the round in progress.
  submissions   Json     @default("{}")

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  player1 User    @relation("Player1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 User    @relation("Player2", fields: [player2Id], references: [id], onDelete: Cascade)
  rounds  Round[]

  @@index([status])
  @@index([player1Id, status])
  @@index([player2Id, status])
  @@index([outcome, finalScore])
}

model Round {
  id          String   @id @default(uuid())
  gameId      String
  roundNumber Int
  player1Word String?
  player2Word String?
  matched     Boolean  @default(false)
  revealedAt  DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, roundNumber])
  @@index([gameId])
}

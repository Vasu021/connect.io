// connect.io — data model
//
// The game is "Connections": 2–8 players in a room each submit one word per
// round, blind. Everyone whose word matches at least one other player connects
// and leaves the circle as a numbered Connection (#1, #2, …). Play continues
// until everyone is connected or one player is left alone.
//
// Two layers of result:
//   • Connection.placement — personal; connect early to place high.
//   • Game.finalScore      — the round the circle closed. Shared. Lower is better.
//
// Only outcome MATCHED carries a finalScore and reaches the leaderboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum RoomStatus {
  LOBBY
  IN_GAME
  CLOSED
}

enum RoomInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GameStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum GameOutcome {
  /// The circle closed: everyone connected, or one player was left alone.
  /// The only outcome that scores.
  MATCHED
  /// Round cap reached with two or more players still unconnected.
  UNMATCHED
  /// Too few players remained to continue.
  ABANDONED
  /// Deliberately ended.
  FORFEITED
}

enum GamePlayerStatus {
  ACTIVE
  CONNECTED
  /// Dropped out, removed after the reconnect grace or for being idle.
  LEFT
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  /// Lowercased mirror of `username`, so lookups and uniqueness are
  /// case-insensitive without relying on a Postgres-specific citext type.
  usernameLower String   @unique
  email         String   @unique
  passwordHash  String
  createdAt     DateTime @default(now())

  sentRequests     FriendRequest[] @relation("RequestFrom")
  receivedRequests FriendRequest[] @relation("RequestTo")
  friendshipsA     Friendship[]    @relation("FriendA")
  friendshipsB     Friendship[]    @relation("FriendB")
  hostedRooms      Room[]          @relation("RoomHost")
  roomMemberships  RoomMember[]
  sentInvites      RoomInvite[]    @relation("InviteFrom")
  receivedInvites  RoomInvite[]    @relation("InviteTo")
  gamePlayers      GamePlayer[]
  submissions      Submission[]

  @@index([usernameLower])
}

model FriendRequest {
  id          String              @id @default(uuid())
  fromUserId  String
  toUserId    String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  fromUser User @relation("RequestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("RequestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  /// Pairs are stored with user1Id < user2Id (lexicographic) so the unique
  /// constraint catches duplicates regardless of who sent the request.
  /// Friendship drives the invite list and presence — it no longer gates play.
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())

  user1 User @relation("FriendA", fields: [user1Id], references: [id], onDelete: Cascade)
  user2 User @relation("FriendB", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
}

model Room {
  id              String     @id @default(uuid())
  code            String     @unique
  name            String?
  /// bcrypt hash. Null means the room is open to anyone holding the code.
  /// An explicit invite bypasses the password.
  passwordHash    String?
  hostId          String
  maxPlayers      Int        @default(8)
  /// How long each round lasts, in milliseconds. The host can change this in
  /// the lobby; it is copied onto the Game when play starts.
  roundDurationMs Int        @default(15000)
  status          RoomStatus @default(LOBBY)
  createdAt       DateTime   @default(now())
  closedAt        DateTime?

  host    User         @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  members RoomMember[]
  invites RoomInvite[]
  games   Game[]

  @@index([status])
  @@index([hostId])
}

model RoomMember {
  id       String   @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model RoomInvite {
  id          String           @id @default(uuid())
  roomId      String
  fromUserId  String
  toUserId    String
  status      RoomInviteStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  fromUser User @relation("InviteFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("InviteTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([roomId, toUserId])
  @@index([toUserId, status])
}

model Game {
  id              String       @id @default(uuid())
  roomId          String
  status          GameStatus   @default(WAITING)
  outcome         GameOutcome?
  /// Round the circle closed. Null unless outcome is MATCHED.
  finalScore      Int?
  /// How many players started. Leaderboards are bucketed by this, because a
  /// score of 6 at eight players is not comparable to 6 at two.
  playerCount     Int
  /// True when nobody was left over.
  perfectCircle   Boolean      @default(false)
  /// Copied from the room at start, so a game keeps the length it was
  /// played at even if the room default changes later.
  roundDurationMs Int          @default(15000)

  /// Live round state, persisted so an in-progress game survives a restart.
  currentRound  Int       @default(0)
  roundDeadline DateTime?
  /// Map of userId -> submitted word for the round in progress.
  submissions   Json      @default("{}")

  createdAt DateTime  @default(now())
  startedAt DateTime?
  endedAt   DateTime?

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  players     GamePlayer[]
  connections Connection[]
  rounds      Round[]
  allWords    Submission[]

  @@index([status])
  @@index([roomId])
  @@index([outcome, playerCount, finalScore])
}

model GamePlayer {
  id               String           @id @default(uuid())
  gameId           String
  userId           String
  status           GamePlayerStatus @default(ACTIVE)
  connectionId     String?
  /// Placement of the Connection this player left in: 1, 2, 3 …
  placement        Int?
  connectedAtRound Int?
  /// Consecutive rounds with no submission; three in a row marks a player LEFT
  /// so one idle tab cannot stall everyone else.
  missedRounds     Int              @default(0)
  joinedAt         DateTime         @default(now())

  game       Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([gameId, userId])
  @@index([userId])
  @@index([gameId, status])
}

/// A group of two or more players who said the same word in the same round.
model Connection {
  id          String   @id @default(uuid())
  gameId      String
  /// 1 for the first group out, 2 for the next, and so on.
  placement   Int
  word        String
  roundNumber Int
  createdAt   DateTime @default(now())

  game    Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  players GamePlayer[]

  @@unique([gameId, placement])
  @@index([gameId])
}

model Round {
  id          String   @id @default(uuid())
  gameId      String
  roundNumber Int
  revealedAt  DateTime @default(now())

  game        Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([gameId, roundNumber])
  @@index([gameId])
}

model Submission {
  id         String  @id @default(uuid())
  roundId    String
  /// Denormalised from the round so the per-game banned-word lookup is a single
  /// indexed query rather than a join.
  gameId     String
  userId     String
  word       String
  /// Output of normalizeWord(): lowercased, trimmed, accents folded. This is
  /// what both matching and the no-repeat rule compare on.
  normalized String
  /// True when this submission was part of a Connection.
  matched    Boolean @default(false)

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([gameId, normalized])
  @@index([userId])
}

enum WordImageStatus {
  /// A fetch is in flight.
  PENDING
  /// Bytes are on disk and servable.
  READY
  /// Pixabay returned no hits for this word. Remembered so we never ask twice.
  NONE
  /// The fetch failed; `nextRetryAt` gates another attempt.
  FAILED
}

/// One cached image per distinct word.
///
/// Keyed on the output of normalizeWord(), the same identity the game already
/// uses for matching and the no-repeat rule, so "Ocean", "ocean " and "océan"
/// share a single image and a single Pixabay request.
///
/// Pixabay forbids permanent hotlinking and its webformat URLs expire after 24
/// hours, so the bytes are downloaded once and served from our own origin. That
/// also keeps game history from rotting.
model WordImage {
  id              String          @id @default(uuid())
  word            String          @unique
  status          WordImageStatus @default(PENDING)
  pixabayId       Int?
  photographer    String?
  photographerUrl String?
  /// Links back to Pixabay, which their terms require whenever images show.
  pageUrl         String?
  /// Pixabay's tag list, used as alt text.
  tags            String?
  /// Relative to the image store directory.
  filePath        String?
  contentType     String?
  width           Int?
  height          Int?
  bytes           Int?
  attempts        Int             @default(0)
  fetchedAt       DateTime?
  /// Backs off retries for FAILED, and re-checks for NONE much later.
  nextRetryAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([nextRetryAt])
}

# Postgres connection string. `docker compose up -d` provisions the dev DB below.
DATABASE_URL="postgresql://connectio:connectio_dev@localhost:5433/connectio?schema=public"

# REQUIRED. Minimum 32 characters — the server refuses to boot without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=""

# Origin allowed by CORS and by the Socket.IO handshake.
CLIENT_ORIGIN="http://localhost:5173"

PORT=4000
NODE_ENV=development

# Cookie flags. Set COOKIE_SECURE=true behind HTTPS in production.
# Use COOKIE_SAMESITE=none (with COOKIE_SECURE=true) only if the API and the
# client are served from different registrable domains.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Optional. Enables a Pixabay image beside each revealed word.
# Without it the game plays normally, just without pictures.
# Get one free at https://pixabay.com/api/docs/
PIXABAY_API_KEY=""
# Stay under Pixabay's documented 100 requests per minute.
# PIXABAY_RATE_LIMIT_PER_MINUTE=80
